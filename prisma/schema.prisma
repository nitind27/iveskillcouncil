// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement()) @db.UnsignedTinyInt
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  users         User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  key         String   @unique @db.VarChar(100)
  label       String   @db.VarChar(150)
  module      String   @db.VarChar(80)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  rolePermissions RolePermission[]
  planPermissions  PlanPermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int   @id @default(autoincrement()) @db.UnsignedInt
  roleId       Int   @map("role_id") @db.UnsignedTinyInt
  permissionId Int   @map("permission_id") @db.UnsignedInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "unique_role_permission")
  @@index([permissionId], map: "idx_role_perm_permission")
  @@map("role_permissions")
}

model PlanPermission {
  id           Int   @id @default(autoincrement()) @db.UnsignedInt
  planId       Int   @map("plan_id") @db.UnsignedTinyInt
  permissionId Int   @map("permission_id") @db.UnsignedInt

  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([planId, permissionId], map: "unique_plan_permission")
  @@index([permissionId], map: "idx_plan_perm_permission")
  @@map("plan_permissions")
}

model User {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roleId             Int      @map("role_id") @db.UnsignedTinyInt
  franchiseId        BigInt?  @map("franchise_id") @db.UnsignedBigInt
  fullName           String   @map("full_name") @db.VarChar(150)
  email              String   @unique @db.VarChar(150)
  phone              String?  @unique @db.VarChar(20)
  password           String   @db.VarChar(255)
  mustChangePassword Boolean  @default(false) @map("must_change_password") @db.TinyInt
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamp

  role      Role      @relation(fields: [roleId], references: [id])
  franchise Franchise? @relation(fields: [franchiseId], references: [id])
  
  ownedFranchises Franchise[] @relation("FranchiseOwner")
  attendance      Attendance[]
  staff           Staff?
  student         Student?
  issuedCertificates Certificate[] @relation("CertificateIssuer")
  requestedCertificates Certificate[] @relation("CertificateRequester")
  announcements   Announcement[] @relation("AnnouncementCreator")
  createdExams    Exam[] @relation("ExamCreator")
  examAttempts    ExamAttempt[]

  @@index([roleId], map: "idx_role")
  @@index([franchiseId], map: "idx_franchise")
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model SubscriptionPlan {
  id            Int      @id @default(autoincrement()) @db.UnsignedTinyInt
  name          PlanType @unique
  price         Decimal  @db.Decimal(10, 2)
  durationInDays Int    @map("duration_in_days")
  status        PlanStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp

  franchises     Franchise[]
  planPermissions PlanPermission[]
  franchiseOrders FranchiseOrder[]
  franchiseApplications FranchiseApplication[]
  planSplitConfig   PlanSplitConfig?

  @@map("subscription_plans")
}

enum PlanType {
  SILVER
  GOLD
  DIAMOND
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

model Franchise {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  name            String        @db.VarChar(150)
  slug            String?       @unique @db.VarChar(100)
  ownerId         BigInt        @map("owner_id") @db.UnsignedBigInt
  planId          Int           @map("plan_id") @db.UnsignedTinyInt
  subscriptionStart DateTime     @map("subscription_start") @db.Date
  subscriptionEnd   DateTime     @map("subscription_end") @db.Date
  address         String?       @db.Text
  city            String?       @db.VarChar(100)
  state           String?       @db.VarChar(100)
  pincode         String?       @db.VarChar(20)
  phone           String?       @db.VarChar(20)
  email           String?       @db.VarChar(150)
  // Business & KYC
  businessType    String?       @map("business_type") @db.VarChar(50)
  legalName       String?       @map("legal_name") @db.VarChar(200)
  alternatePhone  String?       @map("alternate_phone") @db.VarChar(20)
  panNumber       String?       @map("pan_number") @db.VarChar(20)
  aadhaarNumber   String?       @map("aadhaar_number") @db.VarChar(20)
  gstNumber       String?       @map("gst_number") @db.VarChar(30)
  msmeNumber      String?       @map("msme_number") @db.VarChar(50)
  bankName        String?       @map("bank_name") @db.VarChar(100)
  bankAccountName String?       @map("bank_account_name") @db.VarChar(150)
  bankAccountNumber String?     @map("bank_account_number") @db.VarChar(50)
  bankIfsc        String?       @map("bank_ifsc") @db.VarChar(20)
  // KYC documents: [{key,url,name,type,label}]
  documents       Json?         @db.Json
  status          FranchiseStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  // Custom panel config (JSON: logoUrl, primaryColor, siteName, tagline, etc.)
  panelConfig     Json?         @map("panel_config") @db.Json
  // Application reference
  applicationId   BigInt?       @unique @map("application_id") @db.UnsignedBigInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp

  owner           User          @relation("FranchiseOwner", fields: [ownerId], references: [id])
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  application     FranchiseApplication? @relation(fields: [applicationId], references: [id])
  users           User[]
  students        Student[]
  staff           Staff[]
  courses         FranchiseCourseFee[]
  ownedCourses    Course[]      @relation("FranchiseCourses")
  attendance      Attendance[]
  certificates    Certificate[]
  feedback        Feedback[]
  payments        Payment[]

  @@index([ownerId], map: "idx_owner")
  @@index([planId], map: "idx_plan")
  @@index([slug], map: "idx_franchise_slug")
  @@map("franchises")
}

enum FranchiseStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

model FranchiseApplication {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  // Applicant info
  fullName          String    @map("full_name") @db.VarChar(150)
  email             String    @db.VarChar(150)
  phone             String    @db.VarChar(20)
  alternatPhone     String?   @map("alternate_phone") @db.VarChar(20)
  // Business info
  instituteName     String    @map("institute_name") @db.VarChar(200)
  businessType      String    @map("business_type") @db.VarChar(50)
  // Address
  address           String    @db.VarChar(500)
  city              String    @db.VarChar(100)
  state             String    @db.VarChar(100)
  pincode           String    @db.VarChar(20)
  // KYC Documents (stored as JSON array of {type, url, name})
  documents         Json?     @db.Json
  // Status
  status            String    @default("PENDING") @db.VarChar(30)
  adminNotes        String?   @map("admin_notes") @db.Text
  reviewedBy        BigInt?   @map("reviewed_by") @db.UnsignedBigInt
  reviewedAt        DateTime? @map("reviewed_at") @db.DateTime
  // Plan preference
  planId            Int?      @map("plan_id") @db.UnsignedTinyInt
  // Message
  message           String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp

  franchise         Franchise?
  plan              SubscriptionPlan? @relation(fields: [planId], references: [id])
  franchiseOrders   FranchiseOrder[]

  @@index([email], map: "idx_app_email")
  @@index([status], map: "idx_app_status")
  @@map("franchise_applications")
}

model CourseCategory {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(50)
  colorClass  String?  @map("color_class") @db.VarChar(100)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@index([status], map: "idx_cat_status")
  @@index([sortOrder], map: "idx_cat_sort")
  @@map("course_categories")
}

model Course {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  franchiseId      BigInt?       @map("franchise_id") @db.UnsignedBigInt
  name             String        @db.VarChar(150)
  slug             String?       @unique @db.VarChar(160)
  description      String?       @db.Text
  shortDescription String?       @map("short_description") @db.VarChar(300)
  imageUrl         String?       @map("image_url") @db.VarChar(500)
  type             CourseType
  category         String?       @db.VarChar(100)
  level            CourseLevel   @default(BEGINNER)
  mode             CourseMode    @default(OFFLINE)
  baseFee          Decimal       @map("base_fee") @db.Decimal(10, 2)
  durationMonths   Int           @map("duration_months")
  lectures         Int           @default(0)
  videos           Int           @default(0)
  notes            String?       @db.VarChar(255)
  highlights       String?       @db.Text
  status           CourseStatus  @default(ACTIVE)

  /// Advanced catalogue fields (Add Course form)
  awardCategory      String?  @map("award_category") @db.VarChar(100)
  certificateType    String?  @map("certificate_type") @db.VarChar(30) // CERTIFICATE | DIPLOMA
  coursePreposition  String?  @map("course_preposition") @db.VarChar(20) // e.g. In
  mrp                Decimal? @db.Decimal(10, 2)
  displayOrder       Int      @default(0) @map("display_order")
  durationValue      Int?     @map("duration_value")
  durationUnit       String?  @map("duration_unit") @db.VarChar(20) // Days | Months | Years
  previewVideoUrl    String?  @map("preview_video_url") @db.VarChar(500)
  practicalMarks     Int?     @map("practical_marks")
  objectiveMarks     Int?     @map("objective_marks")
  /// [{ plan: "SILVER"|"GOLD"|"DIAMOND", examFee: number }]
  examFeesByPlan     Json?    @map("exam_fees_by_plan") @db.Json
  syllabus           String?  @db.Text
  eligibility        String?  @db.Text
  certificateSubject String?  @map("certificate_subject") @db.VarChar(500)
  /// string[] tags
  tags               Json?    @db.Json
  isPopular          Boolean  @default(false) @map("is_popular") @db.TinyInt
  isRecommended      Boolean  @default(false) @map("is_recommended") @db.TinyInt
  isMrpVisible       Boolean  @default(true) @map("is_mrp_visible") @db.TinyInt
  hideExamResult     Boolean  @default(false) @map("hide_exam_result") @db.TinyInt

  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamp
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamp

  franchise      Franchise?  @relation("FranchiseCourses", fields: [franchiseId], references: [id], onDelete: Cascade)
  students       Student[]
  franchiseFees  FranchiseCourseFee[]

  @@index([franchiseId], map: "idx_course_franchise")
  @@index([category], map: "idx_course_category")
  @@index([status], map: "idx_course_status")
  @@index([displayOrder], map: "idx_course_display_order")
  @@map("courses")
}

enum CourseType {
  SILVER
  GOLD
  DIAMOND
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseMode {
  OFFLINE
  ONLINE
  HYBRID
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

model FranchiseCourseFee {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  franchiseId BigInt @map("franchise_id") @db.UnsignedBigInt
  courseId   BigInt   @map("course_id") @db.UnsignedBigInt
  customFee  Decimal  @map("custom_fee") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([franchiseId, courseId], map: "unique_franchise_course")
  @@index([courseId], map: "fk_fee_course")
  @@map("franchise_course_fees")
}

model Student {
  id           BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  /// Public unique ID e.g. STU-2026-000042 — used in navbar search
  studentCode  String        @unique @map("student_code") @db.VarChar(32)
  userId       BigInt        @unique @map("user_id") @db.UnsignedBigInt
  franchiseId BigInt        @map("franchise_id") @db.UnsignedBigInt
  /// Null until course is assigned in a separate step
  courseId    BigInt?       @map("course_id") @db.UnsignedBigInt
  totalFee    Decimal       @default(0.00) @map("total_fee") @db.Decimal(10, 2)
  paidFee     Decimal       @default(0.00) @map("paid_fee") @db.Decimal(10, 2)
  admissionDate DateTime     @map("admission_date") @db.Date

  firstName          String?   @map("first_name") @db.VarChar(80)
  surname            String?   @db.VarChar(80)
  /// FATHER | HUSBAND | GUARDIAN | OTHER
  relationship       String?   @db.VarChar(40)
  fatherHusbandName  String?   @map("father_husband_name") @db.VarChar(150)
  motherName         String?   @map("mother_name") @db.VarChar(150)
  alternateMobile    String?   @map("alternate_mobile") @db.VarChar(20)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  /// MALE | FEMALE | OTHER
  gender             String?   @db.VarChar(20)
  profileImageUrl    String?   @map("profile_image_url") @db.VarChar(500)
  signatureUrl       String?   @map("signature_url") @db.VarChar(500)
  showFatherOnCertificate  Boolean @default(true) @map("show_father_on_certificate") @db.TinyInt
  showSurnameOnCertificate Boolean @default(true) @map("show_surname_on_certificate") @db.TinyInt

  address     String?       @db.VarChar(500)
  area        String?       @db.VarChar(150)
  pincode     String?       @db.VarChar(20)
  city        String?       @db.VarChar(100)
  state       String?       @db.VarChar(100)
  status      StudentStatus  @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamp

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  franchise   Franchise     @relation(fields: [franchiseId], references: [id])
  course      Course?       @relation(fields: [courseId], references: [id])
  certificates Certificate[]
  feedback    Feedback[]
  payments    Payment[]
  examAttempts ExamAttempt[]

  @@index([franchiseId], map: "idx_student_franchise")
  @@index([courseId], map: "idx_student_course")
  @@map("students")
}

enum StudentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model Staff {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt      @unique @map("user_id") @db.UnsignedBigInt
  franchiseId BigInt     @map("franchise_id") @db.UnsignedBigInt
  salary     Decimal     @db.Decimal(10, 2)
  joiningDate DateTime   @map("joining_date") @db.Date
  status     StaffStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamp

  user       User        @relation(fields: [userId], references: [id])
  franchise Franchise   @relation(fields: [franchiseId], references: [id])

  @@index([franchiseId], map: "idx_staff_franchise")
  @@map("staff")
}

enum StaffStatus {
  ACTIVE
  RESIGNED
}

model Attendance {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt          @map("user_id") @db.UnsignedBigInt
  franchiseId  BigInt          @map("franchise_id") @db.UnsignedBigInt
  attendanceDate DateTime       @map("attendance_date") @db.Date
  status        AttendanceStatus
  method        AttendanceMethod @default(MANUAL)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp

  user          User            @relation(fields: [userId], references: [id])
  franchise     Franchise       @relation(fields: [franchiseId], references: [id])

  @@unique([userId, attendanceDate], map: "unique_attendance")
  @@index([franchiseId], map: "fk_attendance_franchise")
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceMethod {
  MANUAL
  FACE_RECOGNITION
}

model Payment {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  studentId         BigInt        @map("student_id") @db.UnsignedBigInt
  franchiseId      BigInt        @map("franchise_id") @db.UnsignedBigInt
  amount            Decimal       @db.Decimal(10, 2)
  paymentMode       PaymentMode   @map("payment_mode")
  transactionReference String?    @map("transaction_reference") @db.VarChar(150)
  status            PaymentStatus @default(SUCCESS)
  paymentDate       DateTime?     @map("payment_date") @db.DateTime
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp

  student           Student       @relation(fields: [studentId], references: [id])
  franchise         Franchise     @relation(fields: [franchiseId], references: [id])

  @@index([franchiseId], map: "fk_payment_franchise")
  @@index([studentId], map: "idx_payment_student")
  @@map("payments")
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

model Certificate {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  studentId       BigInt            @map("student_id") @db.UnsignedBigInt
  franchiseId    BigInt            @map("franchise_id") @db.UnsignedBigInt
  certificateNumber String          @unique @map("certificate_number") @db.VarChar(100)
  issueDate       DateTime?         @map("issue_date") @db.Date
  status          CertificateStatus @default(REQUESTED)
  issuedBy        BigInt?           @map("issued_by") @db.UnsignedBigInt
  requestedBy     BigInt?           @map("requested_by") @db.UnsignedBigInt
  displayOverrides Json?            @map("display_overrides") @db.Json
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp

  student         Student           @relation(fields: [studentId], references: [id])
  franchise       Franchise         @relation(fields: [franchiseId], references: [id])
  issuer          User?             @relation("CertificateIssuer", fields: [issuedBy], references: [id])
  requester       User?             @relation("CertificateRequester", fields: [requestedBy], references: [id])

  @@index([franchiseId], map: "fk_certificate_franchise")
  @@index([studentId], map: "fk_certificate_student")
  @@index([issuedBy], map: "fk_certificate_admin")
  @@map("certificates")
}

enum CertificateStatus {
  REQUESTED
  APPROVED
  ISSUED
  REJECTED
}

model Feedback {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  studentId   BigInt          @map("student_id") @db.UnsignedBigInt
  franchiseId BigInt          @map("franchise_id") @db.UnsignedBigInt
  message     String          @db.Text
  response    String?         @db.Text
  status      FeedbackStatus  @default(OPEN)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamp

  student     Student         @relation(fields: [studentId], references: [id])
  franchise   Franchise       @relation(fields: [franchiseId], references: [id])

  @@index([studentId], map: "fk_feedback_student")
  @@index([franchiseId], map: "fk_feedback_franchise")
  @@map("feedback")
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model OtpVerification {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  email     String   @db.VarChar(150)
  otp       String   @db.VarChar(10)
  purpose   String   @db.VarChar(50)
  expiresAt DateTime @map("expires_at") @db.DateTime
  used      Boolean  @default(false) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([email, purpose], map: "idx_otp_email_purpose")
  @@index([expiresAt], map: "idx_otp_expires")
  @@map("otp_verifications")
}

model UserPanelSetting {
  id        Int      @id @default(1)
  config    Json     @db.Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@map("user_panel_settings")
}

model GlobalSetting {
  id        Int      @id @default(1)
  config    Json     @db.Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@map("global_settings")
}

model CourseEnrollmentRequest {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fullName    String   @map("full_name") @db.VarChar(150)
  email       String   @db.VarChar(150)
  phone       String   @db.VarChar(20)
  courseName  String   @map("course_name") @db.VarChar(200)
  message     String?  @db.Text
  address     String?  @db.VarChar(500)
  pincode     String?  @db.VarChar(10)
  area        String?  @db.VarChar(150)
  city        String?  @db.VarChar(100)
  state       String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([createdAt], map: "idx_enrollment_created")
  @@map("course_enrollment_requests")
}

model OfferApplication {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fullName    String   @map("full_name") @db.VarChar(150)
  email       String   @db.VarChar(150)
  phone       String   @db.VarChar(20)
  offerId     String   @map("offer_id") @db.VarChar(100)
  offerTitle  String   @map("offer_title") @db.VarChar(200)
  message     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([createdAt], map: "idx_offer_app_created")
  @@map("offer_applications")
}

model FranchiseInquiry {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fullName        String   @map("full_name") @db.VarChar(150)
  email           String   @db.VarChar(150)
  phone           String   @db.VarChar(20)
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(100)
  investmentRange String?  @map("investment_range") @db.VarChar(80)
  message         String?  @db.Text
  franchiseId     String?  @map("franchise_id") @db.VarChar(50)
  franchiseName   String?  @map("franchise_name") @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([createdAt], map: "idx_franchise_inquiry_created")
  @@index([franchiseId], map: "idx_franchise_inquiry_franchise")
  @@map("franchise_inquiries")
}

model FranchiseOrder {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  orderId         String            @unique @map("order_id") @db.VarChar(100)
  cfOrderId       String?           @map("cf_order_id") @db.VarChar(100)
  fullName        String            @map("full_name") @db.VarChar(150)
  email           String            @db.VarChar(150)
  phone           String            @db.VarChar(20)
  planId          Int               @map("plan_id") @db.UnsignedTinyInt
  planName        String            @map("plan_name") @db.VarChar(50)
  amount          Decimal           @db.Decimal(10, 2)
  status          FranchiseOrderStatus @default(PENDING)
  paymentSessionId String?          @map("payment_session_id") @db.VarChar(500)
  cfPaymentId     String?           @map("cf_payment_id") @db.VarChar(100)
  paymentMode     String?           @map("payment_mode") @db.VarChar(50)
  city            String?           @db.VarChar(100)
  state           String?           @db.VarChar(100)
  address         String?           @db.VarChar(500)
  message         String?           @db.Text
  splitApplied    Boolean           @default(false) @map("split_applied") @db.TinyInt
  splitStatus     String?           @map("split_status") @db.VarChar(50)
  splitConfigSnapshot Json?         @map("split_config_snapshot") @db.Json
  applicationId   BigInt?           @map("application_id") @db.UnsignedBigInt
  createdByAdmin  BigInt?           @map("created_by_admin") @db.UnsignedBigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamp

  plan            SubscriptionPlan  @relation(fields: [planId], references: [id])
  application     FranchiseApplication? @relation(fields: [applicationId], references: [id])

  @@index([email], map: "idx_fo_email")
  @@index([status], map: "idx_fo_status")
  @@index([applicationId], map: "idx_fo_application")
  @@map("franchise_orders")
}

enum FranchiseOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// Predefined bank accounts for Cashfree Easy Split (max 3 slots)
model SplitBeneficiary {
  id                Int                    @id @default(autoincrement()) @db.UnsignedTinyInt
  slot              Int                    @unique @db.UnsignedTinyInt
  label             String                 @db.VarChar(100)
  accountHolderName String                 @map("account_holder_name") @db.VarChar(150)
  bankName          String?                @map("bank_name") @db.VarChar(100)
  bankAccountNumber String                 @map("bank_account_number") @db.VarChar(50)
  bankIfsc          String                 @map("bank_ifsc") @db.VarChar(20)
  panNumber         String?                @map("pan_number") @db.VarChar(20)
  email             String?                @db.VarChar(150)
  phone             String?                @db.VarChar(20)
  cashfreeVendorId  String?                @unique @map("cashfree_vendor_id") @db.VarChar(100)
  vendorStatus      String?                @map("vendor_status") @db.VarChar(50)
  status            SplitBeneficiaryStatus @default(ACTIVE)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamp
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamp

  @@map("split_beneficiaries")
}

enum SplitBeneficiaryStatus {
  ACTIVE
  INACTIVE
}

/// Per-plan franchise price split percentages (must sum to 100%)
model PlanSplitConfig {
  id              Int      @id @default(autoincrement()) @db.UnsignedTinyInt
  planId          Int      @unique @map("plan_id") @db.UnsignedTinyInt
  beneficiary1Pct Decimal @map("beneficiary_1_pct") @db.Decimal(5, 2)
  beneficiary2Pct Decimal @map("beneficiary_2_pct") @db.Decimal(5, 2)
  beneficiary3Pct Decimal @map("beneficiary_3_pct") @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active") @db.TinyInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp

  plan            SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_split_configs")
}

model SupportRequest {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fullName  String   @map("full_name") @db.VarChar(150)
  email     String   @db.VarChar(150)
  message   String   @db.Text
  source    String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([createdAt], map: "idx_support_created")
  @@map("support_requests")
}

model Announcement {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  title     String   @db.VarChar(200)
  message   String   @db.Text
  createdBy BigInt   @map("created_by") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  creator   User     @relation("AnnouncementCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "idx_announcement_created")
  @@map("announcements")
}


// ── Chat System ──────────────────────────────────────────────────────────────

model ChatRoom {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// "direct" = 1-on-1 between superadmin and a franchise admin
  /// "group"  = group discussion room
  type        String    @default("direct") @db.VarChar(20)
  name        String?   @db.VarChar(150)
  /// For direct rooms: comma-separated sorted user IDs (e.g. "1_42")
  slug        String?   @unique @db.VarChar(100)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp

  messages    ChatMessage[]
  members     ChatRoomMember[]

  @@index([type], map: "idx_room_type")
  @@index([slug], map: "idx_room_slug")
  @@map("chat_rooms")
}

model ChatRoomMember {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roomId    BigInt   @map("room_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  /// last time this user read messages in this room
  lastReadAt DateTime? @map("last_read_at") @db.DateTime
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamp

  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId], map: "unique_room_member")
  @@index([userId], map: "idx_member_user")
  @@map("chat_room_members")
}

model ChatMessage {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roomId      BigInt   @map("room_id") @db.UnsignedBigInt
  senderId    BigInt   @map("sender_id") @db.UnsignedBigInt
  body        String   @db.Text
  msgType     String   @default("text") @map("msg_type") @db.VarChar(20)
  fileUrl     String?  @map("file_url") @db.VarChar(500)
  fileName    String?  @map("file_name") @db.VarChar(255)
  /// Reply to another message
  replyToId   BigInt?  @map("reply_to_id") @db.UnsignedBigInt
  replyToBody String?  @map("reply_to_body") @db.VarChar(500)
  replyToSender String? @map("reply_to_sender") @db.VarChar(150)
  /// Edit support
  isEdited    Boolean  @default(false) @map("is_edited") @db.TinyInt
  editedAt    DateTime? @map("edited_at") @db.DateTime
  /// Soft delete
  isDeleted   Boolean  @default(false) @map("is_deleted") @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt], map: "idx_msg_room_time")
  @@index([senderId], map: "idx_msg_sender")
  @@map("chat_messages")
}

model ChatTyping {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  roomId    BigInt   @map("room_id") @db.UnsignedBigInt
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  userName  String   @map("user_name") @db.VarChar(150)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp

  @@unique([roomId, userId], map: "unique_typing")
  @@index([roomId], map: "idx_typing_room")
  @@map("chat_typing")
}

// ── Exam System ──────────────────────────────────────────────────────────────

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  TERMINATED
}

/// ASSIGNED = franchise/student portals · LINK = walk-in public link only (hidden from franchise & students)
enum ExamAccessMode {
  ASSIGNED
  LINK
}

model Exam {
  id                 BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  title              String         @db.VarChar(200)
  description        String?        @db.Text
  /// Duration in minutes (e.g. 120 = 2 hours)
  durationMinutes    Int            @map("duration_minutes")
  passPercent        Int            @default(40) @map("pass_percent")
  status             ExamStatus     @default(DRAFT)
  accessMode         ExamAccessMode @default(ASSIGNED) @map("access_mode")
  /// Public walk-in URL token (/exam-link/[token]) — only for LINK mode
  linkToken          String?        @unique @map("link_token") @db.VarChar(64)
  /// Institute admin activates link on site; deactivate closes new starts
  linkActive         Boolean        @default(false) @map("link_active") @db.TinyInt
  batchLabel         String?        @map("batch_label") @db.VarChar(150)
  requireCamera      Boolean        @default(true) @map("require_camera") @db.TinyInt
  requireFaceDetect  Boolean        @default(true) @map("require_face_detect") @db.TinyInt
  maxFaceViolations  Int            @default(3) @map("max_face_violations")
  shuffleQuestions   Boolean        @default(true) @map("shuffle_questions") @db.TinyInt
  startsAt           DateTime?      @map("starts_at") @db.DateTime
  endsAt             DateTime?      @map("ends_at") @db.DateTime
  createdBy          BigInt         @map("created_by") @db.UnsignedBigInt
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamp
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamp

  creator            User           @relation("ExamCreator", fields: [createdBy], references: [id])
  targets            ExamTarget[]
  questions          ExamQuestion[]
  attempts           ExamAttempt[]

  @@index([status], map: "idx_exam_status")
  @@index([createdBy], map: "idx_exam_creator")
  @@index([accessMode], map: "idx_exam_access_mode")
  @@map("exams")
}

/// Which franchise + course (batch) this exam is for
model ExamTarget {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  examId      BigInt   @map("exam_id") @db.UnsignedBigInt
  franchiseId BigInt   @map("franchise_id") @db.UnsignedBigInt
  courseId    BigInt   @map("course_id") @db.UnsignedBigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp

  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, franchiseId, courseId], map: "unique_exam_target")
  @@index([franchiseId, courseId], map: "idx_exam_target_fc")
  @@map("exam_targets")
}

model ExamQuestion {
  id        BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  examId    BigInt            @map("exam_id") @db.UnsignedBigInt
  text      String           @db.Text
  type      ExamQuestionType @default(SINGLE_CHOICE)
  marks     Int              @default(1)
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamp

  exam      Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options   ExamOption[]
  answers   ExamAnswer[]

  @@index([examId], map: "idx_exam_question_exam")
  @@map("exam_questions")
}

model ExamOption {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  questionId BigInt   @map("question_id") @db.UnsignedBigInt
  text       String   @db.VarChar(500)
  isCorrect  Boolean  @default(false) @map("is_correct") @db.TinyInt
  sortOrder  Int      @default(0) @map("sort_order")

  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId], map: "idx_exam_option_q")
  @@map("exam_options")
}

model ExamAttempt {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  examId         BigInt             @map("exam_id") @db.UnsignedBigInt
  /// Null for walk-in (LINK) attempts — identity is enrollmentNumber
  studentId      BigInt?           @map("student_id") @db.UnsignedBigInt
  userId         BigInt?            @map("user_id") @db.UnsignedBigInt
  /// Secret for walk-in take APIs (no student login)
  accessKey      String?           @unique @map("access_key") @db.VarChar(64)
  status         ExamAttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamp
  /// Hard deadline = startedAt + exam.durationMinutes
  endsAt         DateTime          @map("ends_at") @db.DateTime
  submittedAt    DateTime?         @map("submitted_at") @db.DateTime
  score          Decimal?          @db.Decimal(10, 2)
  maxScore       Decimal?          @map("max_score") @db.Decimal(10, 2)
  percent        Decimal?          @db.Decimal(5, 2)
  passed         Boolean?          @db.TinyInt
  faceViolations Int               @default(0) @map("face_violations")
  /// Student enters before start
  enrollmentNumber String?         @map("enrollment_number") @db.VarChar(80)
  /// Selfie / ID photo captured before start
  photoUrl         String?         @map("photo_url") @db.VarChar(500)
  /// Seconds remaining when proctor terminated (for resume)
  remainingSecondsAtStop Int?      @map("remaining_seconds_at_stop")
  /// Institute admin approved student to continue from where they left
  restartApprovedAt DateTime?      @map("restart_approved_at") @db.DateTime
  questionOrder  Json?             @map("question_order")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamp
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamp

  exam           Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        ExamAnswer[]
  proctorEvents  ExamProctorEvent[]

  @@unique([examId, studentId], map: "unique_exam_student_attempt")
  @@index([userId], map: "idx_attempt_user")
  @@index([status], map: "idx_attempt_status")
  @@index([examId, enrollmentNumber], map: "idx_attempt_exam_enrollment")
  @@map("exam_attempts")
}

model ExamAnswer {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  attemptId         BigInt   @map("attempt_id") @db.UnsignedBigInt
  questionId        BigInt   @map("question_id") @db.UnsignedBigInt
  /// Selected option IDs as JSON string array
  selectedOptionIds Json     @map("selected_option_ids")
  isCorrect         Boolean? @map("is_correct") @db.TinyInt
  marksAwarded      Decimal? @map("marks_awarded") @db.Decimal(10, 2)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp

  attempt           ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId], map: "unique_attempt_question")
  @@map("exam_answers")
}

model ExamProctorEvent {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  attemptId BigInt   @map("attempt_id") @db.UnsignedBigInt
  /// NO_FACE | MULTIPLE_FACES | TAB_HIDDEN | CAMERA_LOST | LOOKING_AWAY
  type      String   @db.VarChar(40)
  detail    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId], map: "idx_proctor_attempt")
  @@map("exam_proctor_events")
}
